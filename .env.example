# ---------------------------------------------------------------
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# ---------------------------------------------------------------

# Servidor HTTP
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS (* = cualquiera)
CORS_ORIGIN=*

# SQL Server (autenticación SQL, TCP/IP habilitado)
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=MythosReservasDB
SQL_USER=sa
# Sin "#" (en .env inicia un comentario). Con Docker: 8+ caracteres, mayúsculas, minúsculas y números.
SQL_PASSWORD=REEMPLAZAR_CON_TU_CLAVE
SQL_ENCRYPT=false
SQL_TRUST_CERTIFICATE=true

# MongoDB (local o Atlas: mongodb+srv://usuario:clave@cluster/...)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=MythosLogs
# Días que se conservan los logs antes de que el índice TTL los elimine
MONGO_LOGS_TTL_DIAS=90

# Opcional (solo para npm run db:setup): ruta del repositorio EP-Backend_BBDD.
# Si se deja vacía, se busca en la carpeta vecina ../EP-Backend_BBDD
BBDD_REPO=
